From: skyjet18 <57456827+skyjet18@users.noreply.github.com>
Date: Wed, 4 Nov 2026 08:24:13 +0100
Subject: [PATCH 38/49] options to replace parts of key uri in HLS

Ported to FFmpeg 9.0.2 from 0006-options-to-replace-parts-of-key-uri-in-HLS.patch.
The key_uri_old/key_uri_new options and the replacement in read_key()
are already in the OE-A base (0004-hls-replace-key-uri), so no second
implementation is added. Only the missing part of the original is
ported: the replaced URL is freed on every path (the base leaked it when
the key could not be opened or read), and an allocation failure of
av_strireplace() is handled instead of passing NULL to open_url().
---
 libavformat/hls.c | 19 +++++++++++--------
 1 file changed, 11 insertions(+), 8 deletions(-)

diff --git a/libavformat/hls.c b/libavformat/hls.c
index 2824168e..6b3e7673 100644
--- a/libavformat/hls.c
+++ b/libavformat/hls.c
@@ -1425,6 +1425,7 @@ static int read_key(HLSContext *c, struct playlist *pls, struct segment *seg)
 {
     AVIOContext *pb = NULL;
     char *key_url = NULL;
+    int ret;
 
     if (!strncmp(seg->key, "key://", 6)) {
         /* the key is given directly as hex string */
@@ -1444,14 +1445,18 @@ static int read_key(HLSContext *c, struct playlist *pls, struct segment *seg)
         return 0;
     }
 
-    if (NULL != c->key_uri_replace_old && \
-		NULL != c-> key_uri_replace_new && \
-		'\0' != c->key_uri_replace_old[0]) {
-		key_url = av_strireplace(seg->key, c->key_uri_replace_old, c->key_uri_replace_new);
+    if (c->key_uri_replace_old && c->key_uri_replace_new &&
+        c->key_uri_replace_old[0]) {
+        key_url = av_strireplace(seg->key, c->key_uri_replace_old, c->key_uri_replace_new);
+        if (!key_url)
+            return AVERROR(ENOMEM);
     } else {
-		key_url = seg->key;
+        key_url = seg->key;
     }
-    int ret = open_url(pls->parent, &pb, key_url, &c->avio_opts, NULL, NULL);
+
+    ret = open_url(pls->parent, &pb, key_url, &c->avio_opts, NULL, NULL);
+    if (key_url != seg->key)
+        av_free(key_url);
     if (ret < 0) {
         av_log(pls->parent, AV_LOG_ERROR, "Unable to open key file %s, %s\n",
                seg->key, av_err2str(ret));
@@ -1474,8 +1479,6 @@ static int read_key(HLSContext *c, struct playlist *pls, struct segment *seg)
     }
 
     av_strlcpy(pls->key_url, seg->key, sizeof(pls->key_url));
-    if (key_url != seg->key)
-    		av_free(key_url);
 
     return 0;
 }
