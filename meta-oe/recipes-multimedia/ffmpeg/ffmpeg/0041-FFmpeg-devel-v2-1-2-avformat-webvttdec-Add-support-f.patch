From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: skyjet18 <57456827+skyjet18@users.noreply.github.com>
Date: Wed, 4 Nov 2026 08:26:37 +0100
Subject: [PATCH 41/49] [FFmpeg-devel,v2,1/2] avformat/webvttdec: Add support
 for HLS WebVTT MPEG timestamp map

https://patchwork.ffmpeg.org/project/ffmpeg/patch/20170205194344.333-1-franklinphillips@gmx.com/

Ported to FFmpeg 9.0.2 from 0010-FFmpeg-devel-v2-1-2-avformat-webvttdec-Add-support-f.patch.
9.0.2 hls.c already sets prefer_hls_mpegts_pts for its segment demuxers,
but webvttdec.c has no such option, so X-TIMESTAMP-MAP was ignored. The
option and the timestamp conversion are ported unchanged; the STYLE and
REGION skip is upstream, the map is read from the header chunk there.
hls_ts_offset is initialised to avoid a maybe-uninitialized warning.
Review: the option defaults to 0. The HLS demuxer enables it explicitly
for its own segment demuxers (hls.c, seg_format_opts), so a stand-alone
WebVTT file is not shifted by its X-TIMESTAMP-MAP.
---
 libavformat/webvttdec.c | 45 ++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 44 insertions(+), 1 deletion(-)

diff --git a/libavformat/webvttdec.c b/libavformat/webvttdec.c
index 436bc1c5..928bdb99 100644
--- a/libavformat/webvttdec.c
+++ b/libavformat/webvttdec.c
@@ -36,6 +36,7 @@ typedef struct {
     const AVClass *class;
     FFDemuxSubtitlesQueue q;
     int kind;
+    int prefer_hls_mpegts_pts;
 } WebVTTContext;
 
 static int webvtt_probe(const AVProbeData *p)
@@ -58,12 +59,19 @@ static int64_t read_ts(const char *s)
     return AV_NOPTS_VALUE;
 }
 
+static int64_t convert_to_hls_mpegts_ts(int64_t timestamp, int64_t offset)
+{
+     return (timestamp * 90 + offset) & ((1LL << 33) - 1);
+}
+
 static int webvtt_read_header(AVFormatContext *s)
 {
     WebVTTContext *webvtt = s->priv_data;
     AVBPrint cue;
     int res = 0;
     AVStream *st = avformat_new_stream(s, NULL);
+    int has_hls_timestamp_map = 0;
+    int64_t hls_ts_offset = 0;
 
     if (!st)
         return AVERROR(ENOMEM);
@@ -97,8 +105,36 @@ static int webvtt_read_header(AVFormatContext *s)
             !strncmp(p, "WEBVTT", 6) ||
             !strncmp(p, "STYLE", 5) ||
             !strncmp(p, "REGION", 6) ||
-            !strncmp(p, "NOTE", 4))
+            !strncmp(p, "NOTE", 4)) {
+
+            if (webvtt->prefer_hls_mpegts_pts) {
+                /*
+                 * WebVTT files in HLS streams contain a timestamp offset for
+                 * syncing with the main stream:
+                 *
+                 * X-TIMESTAMP-MAP=LOCAL:00:00:00.000,MPEGTS:900000
+                 * (LOCAL and MPEGTS can be reversed even though HLS spec
+                 *  does not say so)
+                 */
+
+                const char *hls_timestamp_map = strstr(p, "\nX-TIMESTAMP-MAP=");
+                if (hls_timestamp_map) {
+                    const char *native_str = strstr(hls_timestamp_map, "LOCAL:");
+                    const char *mpegts_str = strstr(hls_timestamp_map, "MPEGTS:");
+                    if (native_str && mpegts_str) {
+                        int64_t native_ts = read_ts(native_str + 6);
+                        int64_t mpegts_ts = strtoll(mpegts_str + 7, NULL, 10);
+
+                        if (native_ts != AV_NOPTS_VALUE) {
+                            hls_ts_offset = mpegts_ts - native_ts * 90;
+                            has_hls_timestamp_map = 1;
+                            avpriv_set_pts_info(st, 33, 1, 90000);
+                        }
+                    }
+                }
+            }
             continue;
+        }
 
         /* optional cue identifier (can be a number like in SRT or some kind of
          * chaptering id) */
@@ -132,6 +168,12 @@ static int webvtt_read_header(AVFormatContext *s)
         if ((ts_end = read_ts(p)) == AV_NOPTS_VALUE)
             break;
 
+        if (has_hls_timestamp_map) {
+            /* convert and truncate to MPEG TS timestamps */
+            ts_start = convert_to_hls_mpegts_ts(ts_start, hls_ts_offset);
+            ts_end = convert_to_hls_mpegts_ts(ts_end, hls_ts_offset);
+        }
+
         /* optional cue settings */
         p += strcspn(p, "\n\r\t ");
         while (*p == '\t' || *p == ' ')
@@ -206,6 +248,7 @@ static const AVOption options[] = {
         { "captions",     "WebVTT captions kind",     0, AV_OPT_TYPE_CONST, { .i64 = AV_DISPOSITION_CAPTIONS },     INT_MIN, INT_MAX, KIND_FLAGS, .unit = "webvtt_kind" },
         { "descriptions", "WebVTT descriptions kind", 0, AV_OPT_TYPE_CONST, { .i64 = AV_DISPOSITION_DESCRIPTIONS }, INT_MIN, INT_MAX, KIND_FLAGS, .unit = "webvtt_kind" },
         { "metadata",     "WebVTT metadata kind",     0, AV_OPT_TYPE_CONST, { .i64 = AV_DISPOSITION_METADATA },     INT_MIN, INT_MAX, KIND_FLAGS, .unit = "webvtt_kind" },
+    { "prefer_hls_mpegts_pts", "Use WebVTT embedded HLS MPEGTS timestamps if available.", OFFSET(prefer_hls_mpegts_pts), AV_OPT_TYPE_INT, { .i64 = 0 }, 0, 1, KIND_FLAGS },
     { NULL }
 };
 
