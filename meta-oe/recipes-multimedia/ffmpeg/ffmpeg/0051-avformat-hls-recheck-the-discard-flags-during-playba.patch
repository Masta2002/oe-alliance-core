From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Masta2002 <Masta2002@gmx.net>
Date: Mon, 9 Nov 2026 21:32:45 +0100
Subject: [PATCH 51/51] avformat/hls: recheck the discard flags during playback
 and reset a playlist that is switched in

OE-A patch 0008 ("recheck discard flags") calls recheck_discard_flags()
only before the first packet. A playlist whose streams the player sets
from AVDISCARD_ALL back to AVDISCARD_DEFAULT later, an alternative audio
rendition or a subtitle selected during playback, is then never switched
in: the selected track stays silent. A playlist is still switched out at
its next segment (reload_playlist() checks playlist_needed()), so the
player can drop a track, but not get one back.

Call recheck_discard_flags(s, c->first_packet) for every packet again,
as FFmpeg 9.0.2 does; this restores the upstream behaviour that patch
0008 restricted to the first packet.

A playlist that is switched in during playback was read before, for the
stream info or until its streams were discarded. The packet that was
buffered for it, the rest of the old segment in the I/O buffer and the
packets queued in the segment demuxer belong to that old position and
were returned before the data of the newly selected segment. Reset the
playlist the way hls_read_seek() does: the common part of the seek is
now reset_playlist(), used by both. The segment is then selected and the
packets before the playing position are dropped as before
(select_cur_seq_no(), discontinuity_select(), seek_timestamp =
cur_timestamp).

Nothing changes for a caller that does not change the discard flags
after the first packet: playlist_needed() then returns what pls->needed
already holds, neither branch of recheck_discard_flags() is taken, and
the per-packet call is what 9.0.2 has. Before the first packet the reset
is skipped (first), that path is as before. hls_read_seek() executes the
same statements in the same order through reset_playlist(). Switching
out stays as in 9.0.2 (first packet here, else in reload_playlist()).

Based on skyjet18/FFmpeg release/6.1-patched f975f8f ("avformat/hls:
restore audio playlist switching and live timing").
Port: written on top of the 9.0.2 code and of the #EXT-X-DISCONTINUITY
patch, whose discontinuity_select() replaces the discontinuity lines of
f975f8f in the switch-in branch. reset_playlist() is exactly the 9.0.2
seek code (with input_reuse and the pts_wrap_reference reset, without
f975f8f's pb->error and discontinuity_pending lines; the latter is done
by discontinuity_select()). Not ported: the per-playlist
window_start_offset of f975f8f (live timing), c5cda84 (seek skips
inactive playlists), 25233be (live rendition timing) and the tests.
---
 libavformat/hls.c | 69 +++++++++++++++++++++++++++++------------------
 1 file changed, 43 insertions(+), 26 deletions(-)

diff --git a/libavformat/hls.c b/libavformat/hls.c
index 8f46c35c99..eb611474c0 100644
--- a/libavformat/hls.c
+++ b/libavformat/hls.c
@@ -3022,6 +3022,37 @@ static int hls_read_header(AVFormatContext *s)
     return 0;
 }
 
+/* Restart the reading of a playlist (seek, playlist switched in again):
+ * drop the segment connections and everything buffered from the old
+ * position, in the I/O context, the packet and the segment demuxer. */
+static void reset_playlist(struct playlist *pls)
+{
+    AVIOContext *const pb = &pls->pb.pub;
+
+    ff_format_io_close(pls->parent, &pls->input);
+    pls->input_read_done = 0;
+    pls->input_reuse = 0;
+    ff_format_io_close(pls->parent, &pls->input_next);
+    pls->input_next_requested = 0;
+    av_packet_unref(pls->pkt);
+    pb->eof_reached = 0;
+    /* Clear any buffered data */
+    pb->buf_end = pb->buf_ptr = pb->buffer;
+    /* Reset the pos, to let the mpegts/mov demuxer know we've seeked. */
+    pb->pos = 0;
+    /* Flush the packet queue of the subdemuxer. */
+    if (pls->ctx) {
+        ff_read_frame_flush(pls->ctx);
+        for (unsigned j = 0; j < pls->ctx->nb_streams; j++)
+            ffstream(pls->ctx->streams[j])->pts_wrap_reference = AV_NOPTS_VALUE;
+    }
+    if (pls->is_subtitle)
+        avformat_close_input(&pls->ctx);
+
+    /* Reset the init segment so it's re-fetched and served appropriately */
+    pls->cur_init_section = NULL;
+}
+
 static int recheck_discard_flags(AVFormatContext *s, int first)
 {
     HLSContext *c = s->priv_data;
@@ -3040,6 +3071,15 @@ static int recheck_discard_flags(AVFormatContext *s, int first)
         if (cur_needed && !pls->needed) {
             pls->needed = 1;
             changed = 1;
+            /* A playlist switched in during playback may have been read
+             * before (for the stream info, or until its streams were
+             * discarded): what is left of that, a buffered packet, the
+             * rest of a segment, packets queued in the segment demuxer,
+             * belongs to another position. Restart it like a seek does.
+             * (Before the first packet only playlists that were not read
+             * yet are switched in.) */
+            if (!first)
+                reset_playlist(pls);
             pls->cur_seq_no = select_cur_seq_no(c, pls);
             discontinuity_select(c, pls, 1);
             pls->pb.pub.eof_reached = 0;
@@ -3137,10 +3177,8 @@ static int hls_read_packet(AVFormatContext *s, AVPacket *pkt)
     HLSContext *c = s->priv_data;
     int ret, i, minplaylist = -1;
 
-    if (c->first_packet) {
-        recheck_discard_flags(s, 1);
-        c->first_packet = 0;
-    }
+    recheck_discard_flags(s, c->first_packet);
+    c->first_packet = 0;
 
     for (i = 0; i < c->n_playlists; i++) {
         struct playlist *pls = c->playlists[i];
@@ -3476,29 +3514,8 @@ static int hls_read_seek(AVFormatContext *s, int stream_index,
     for (i = 0; i < c->n_playlists; i++) {
         /* Reset reading */
         struct playlist *pls = c->playlists[i];
-        AVIOContext *const pb = &pls->pb.pub;
-        ff_format_io_close(pls->parent, &pls->input);
-        pls->input_read_done = 0;
-        pls->input_reuse = 0;
-        ff_format_io_close(pls->parent, &pls->input_next);
-        pls->input_next_requested = 0;
-        av_packet_unref(pls->pkt);
-        pb->eof_reached = 0;
-        /* Clear any buffered data */
-        pb->buf_end = pb->buf_ptr = pb->buffer;
-        /* Reset the pos, to let the mpegts/mov demuxer know we've seeked. */
-        pb->pos = 0;
-        /* Flush the packet queue of the subdemuxer. */
-        if (pls->ctx) {
-            ff_read_frame_flush(pls->ctx);
-            for (j = 0; j < (int)pls->ctx->nb_streams; j++)
-                ffstream(pls->ctx->streams[j])->pts_wrap_reference = AV_NOPTS_VALUE;
-        }
-        if (pls->is_subtitle)
-            avformat_close_input(&pls->ctx);
 
-        /* Reset the init segment so it's re-fetched and served appropriately */
-        pls->cur_init_section = NULL;
+        reset_playlist(pls);
 
         /* The discard in hls_read_packet compares this playlist's packet DTS
          * against seek_timestamp, but seek_timestamp is on c->first_timestamp's
