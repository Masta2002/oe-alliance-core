From: skyjet18 <57456827+skyjet18@users.noreply.github.com>
Date: Wed, 4 Nov 2026 08:28:13 +0100
Subject: [PATCH 24/49] dashdec: don't skip first segment

Ported to FFmpeg 9.0.2 from 0025-dashdec-don-t-skip-first-segment.patch.
Port: applied clean (offset only).
---
 libavformat/dashdec.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/libavformat/dashdec.c b/libavformat/dashdec.c
index ab3e1ba3..c6b48d66 100644
--- a/libavformat/dashdec.c
+++ b/libavformat/dashdec.c
@@ -1820,7 +1820,7 @@ try_again:
             refresh_manifest(pls->parent);
             pls->parent->duration = (int64_t) c->time_shift_buffer_depth * AV_TIME_BASE;
         }
-        if (pls->cur_seq_no <= min_seq_no) {
+        if (pls->cur_seq_no < min_seq_no) {
             av_log(pls->parent, AV_LOG_VERBOSE, "old fragment: cur[%"PRId64"] min[%"PRId64"] max[%"PRId64"]\n", (int64_t)pls->cur_seq_no, min_seq_no, max_seq_no);
             pls->cur_seq_no = calc_cur_seg_no(pls->parent, pls);
         } else if (pls->cur_seq_no > max_seq_no) {
