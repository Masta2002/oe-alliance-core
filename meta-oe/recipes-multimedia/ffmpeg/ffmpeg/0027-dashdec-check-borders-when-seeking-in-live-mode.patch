From: skyjet18 <57456827+skyjet18@users.noreply.github.com>
Date: Wed, 4 Nov 2026 08:28:41 +0100
Subject: [PATCH 27/49] dashdec: check borders when seeking in live mode

Ported to FFmpeg 9.0.2 from 0028-dashdec-check-borders-when-seeking-in-live-mode.patch.
Port: applied clean (offset only).
Review: the seek limit is computed with av_rescale(start_time, 1000,
fragment_timescale) instead of the integer-second division, keeping the
sub-second part; min_buffer_time (seconds) is scaled to milliseconds
separately.
---
 libavformat/dashdec.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/libavformat/dashdec.c b/libavformat/dashdec.c
index f9ad4a9b..ed4c2944 100644
--- a/libavformat/dashdec.c
+++ b/libavformat/dashdec.c
@@ -2626,6 +2626,7 @@ static int dash_close(AVFormatContext *s)
 
 static int dash_seek(AVFormatContext *s, struct representation *pls, int64_t seek_pos_msec, int flags, int dry_run)
 {
+    DASHContext *c = s->priv_data;
     int ret = 0;
     int i = 0;
     int j = 0;
@@ -2654,6 +2655,18 @@ static int dash_seek(AVFormatContext *s, struct representation *pls, int64_t see
             seek_pos_msec += av_rescale_q(pls->first_pts, pls->ctx->streams[0]->time_base,
                                           (AVRational){ 1, 1000 });
 
+        if(c->is_live)
+        {
+            /* don't allow to jump after last available segment */
+            int64_t seek_limit = av_rescale(get_segment_start_time_based_on_timeline(pls, 0xFFFFFFFF), 1000, pls->fragment_timescale)
+                                 - 2 * c->min_buffer_time * 1000;
+
+            if( seek_limit < seek_pos_msec )
+            {
+                seek_pos_msec = seek_limit;
+            }
+        }
+
         av_log(pls->parent, AV_LOG_VERBOSE, "dash_seek with SegmentTimeline start n_timelines[%d] "
                "last_seq_no[%"PRId64"].\n",
                (int)pls->n_timelines, (int64_t)pls->last_seq_no);
