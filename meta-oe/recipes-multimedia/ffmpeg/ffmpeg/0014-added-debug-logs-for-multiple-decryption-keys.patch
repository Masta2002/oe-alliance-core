From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: skyjet18 <57456827+skyjet18@users.noreply.github.com>
Date: Wed, 4 Nov 2026 08:23:16 +0100
Subject: [PATCH 14/49] added debug logs for multiple decryption keys

Ported to FFmpeg 9.0.2 from 0002-added-debug-logs-for-multiple-decryption-keys.patch.
Port: applied with offset; fixed the operator precedence in the key length
check (key_entry_len got the comparison result) and log it with %zu.
---
 libavformat/mov.c | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/libavformat/mov.c b/libavformat/mov.c
index 31bec1d5..9d2f74e6 100644
--- a/libavformat/mov.c
+++ b/libavformat/mov.c
@@ -8335,6 +8335,7 @@ static int mov_read_dfla(MOVContext *c, AVIOContext *pb, MOVAtom atom)
 static int get_key_from_kid(uint8_t* out, int len, MOVContext *c, AVEncryptionInfo *sample) {
     AVDictionaryEntry *key_entry_hex;
     char kid_hex[16*2+1];
+    size_t key_entry_len;
 
     if (c->decryption_default_key && c->decryption_default_key_len != len) {
         av_log(c->fc, AV_LOG_ERROR, "invalid default decryption key length: got %d, expected %d\n", c->decryption_default_key_len, len);
@@ -8344,6 +8345,7 @@ static int get_key_from_kid(uint8_t* out, int len, MOVContext *c, AVEncryptionIn
     if (!c->decryption_keys) {
         av_assert0(c->decryption_default_key);
         memcpy(out, c->decryption_default_key, len);
+        av_log(c->fc, AV_LOG_DEBUG, "Returning default decryption key\n");
         return 0;
     }
 
@@ -8354,18 +8356,24 @@ static int get_key_from_kid(uint8_t* out, int len, MOVContext *c, AVEncryptionIn
 
     ff_data_to_hex(kid_hex, sample->key_id, 16, 1);
     key_entry_hex = av_dict_get(c->decryption_keys, kid_hex, NULL, AV_DICT_DONT_STRDUP_KEY|AV_DICT_DONT_STRDUP_VAL);
+
     if (!key_entry_hex) {
         if (!c->decryption_default_key) {
             av_log(c->fc, AV_LOG_ERROR, "unable to find KID %s\n", kid_hex);
             return -1;
         }
         memcpy(out, c->decryption_default_key, len);
+        av_log(c->fc, AV_LOG_DEBUG, "Returning default decryption key\n");
         return 0;
     }
-    if (strlen(key_entry_hex->value) != len*2) {
+
+    key_entry_len = strlen(key_entry_hex->value);
+    if (key_entry_len != len*2) {
+        av_log(c->fc, AV_LOG_ERROR, "wrong key length: %zu\n", key_entry_len);
         return -1;
     }
     ff_hex_to_data(out, key_entry_hex->value);
+    av_log(c->fc, AV_LOG_DEBUG, "Returning decryption key %s for kid %s\n", key_entry_hex->value, kid_hex);
     return 0;
 }
 
